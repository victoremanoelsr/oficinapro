{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oficina Pro",
  "version": "1.4.0",
  "identifier": "br.com.oficinapro.desktop",
  "mainBinaryName": "Oficina Pro",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "windows": {
      "staticVCRuntime": true
    }
  },
  "app": {
    "windows": [{
      "title": "Oficina Pro",
      "width": 1280,
      "height": 800,
      "minWidth": 1050,
      "minHeight": 680,
      "resizable": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Business",
    "publisher": "Oficina Pro",
    "shortDescription": "Sistema de gestão de oficinas",
    "longDescription": "Sistema completo e offline para clientes, ordens de serviço, estoque e financeiro.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
